{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ranch",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ranch",
    },
  ],
  "routes": [
    {
      "pattern": "ranch.knipe.io",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ATTENDANCE_SITE_URL": "https://ranch.knipe.io",
  },
  "triggers": {
    "crons": ["0 23 * * 3", "0 0 * * 4"],
  },
  "images": {
    "binding": "IMAGES",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["admin@ranch.knipe.io"],
      "allowed_destination_addresses": [
        "susie.knipe@gmail.com",
        "suzeadmin@gmail.com",
        "nk@nknipe.com",
      ],
    },
  ],
  "r2_buckets": [
    {
      "binding": "COI_BUCKET",
      "bucket_name": "family-tools-coi",
    },
    {
      "binding": "HOURS_BUCKET",
      "bucket_name": "family-tools-hours",
    },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "74636801",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
}
